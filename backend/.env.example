# 이 파일을 복사해서 .env 로 만들고 값을 채우세요.
#   cp .env.example .env
#
# .env 는 .gitignore에 등록되어 있어 커밋되지 않습니다.
# application.yaml 의 spring.config.import 가 이 파일을 읽습니다.
# (스프링이 .env를 기본 지원하는 건 아니고, KEY=VALUE 형식이 properties와 같아서 가능)

# ── MySQL (기본) ──────────────────────────────────────────────
# 비밀번호만 채우면 됩니다. DB(groupware)와 테이블은 앱이 알아서 만듭니다.
DB_PASSWORD=
DB_USERNAME=root
DB_URL=jdbc:mysql://localhost:3306/groupware?createDatabaseIfNotExist=true&serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_DRIVER=com.mysql.cj.jdbc.Driver

# ── MySQL 없이 바로 띄우고 싶을 때 ────────────────────────────
# 위 4줄을 지우고 아래 4줄을 쓰면 설치·비밀번호 없이 실행됩니다.
# 파일로 저장되므로 재시작해도 데이터가 남습니다.
#
# DB_URL=jdbc:h2:file:./data/groupware;MODE=MySQL;DB_CLOSE_DELAY=-1
# DB_DRIVER=org.h2.Driver
# DB_USERNAME=sa
# DB_PASSWORD=
